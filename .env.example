# Outlook IMAP — generate an App Password at https://account.microsoft.com/security
# Account must have 2FA enabled to issue App Passwords.
OUTLOOK_USER=marcelo_v.maciel@outlook.com
OUTLOOK_APP_PASSWORD=xxxxxxxxxxxxxxxx
OUTLOOK_IMAP_HOST=outlook.office365.com
OUTLOOK_IMAP_PORT=993

# Second Brain — SQLite path for the indexed emails
SECOND_BRAIN_DB=./data/second_brain.db

# How many days back to fetch on the first run (subsequent runs are incremental via UID).
INITIAL_LOOKBACK_DAYS=180

# Folders to scan, comma-separated. Leave default for INBOX only.
IMAP_FOLDERS=INBOX

# Set to 1 to log per-message decisions (for debugging classifier).
VERBOSE=0

# ─────────────────────────────────────────────────────────────
# Triagem de WhatsApp (main_triage.py)
# ─────────────────────────────────────────────────────────────

# Segredo partilhado entre o telemóvel e o VPS. Gera um novo com:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# Mínimo 32 caracteres. Sem isto, qualquer pessoa pode injetar alertas falsos.
TRIAGEM_INGEST_TOKEN=

# Onde o serviço escuta. Fica em localhost: o Caddy é que expõe com TLS.
TRIAGEM_BIND_HOST=127.0.0.1
TRIAGEM_BIND_PORT=8099

# Base de dados da triagem (separada do Second Brain).
TRIAGEM_DB=./data/triagem.db

# Quantas horas o texto original das mensagens fica guardado. Ao fim do prazo
# o texto é apagado e sobra só a classificação. Quanto menos, melhor.
TRIAGEM_RETER_HORAS=48

# 0 = nunca guardar o texto das mensagens. Os avisos urgentes continuam a
# funcionar; o resumo diário passa a nomear a conversa sem a citar.
TRIAGEM_GUARDAR_TEXTO=1

# Telegram — só saída. A Mia nunca lê nem responde por aqui.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic — cria em https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=

# Modelo e teto de gasto. Passado o teto diário de chamadas, tudo cai em
# "requer_resposta" e o resumo avisa. Um dia de 800 mensagens fica em ~$0,16.
TRIAGEM_MODELO=claude-haiku-4-5
TRIAGEM_LOTE_MAX=20
TRIAGEM_TETO_CHAMADAS_DIA=200

# Regras fixas. As conversas urgentes são nomes tal como aparecem no WhatsApp.
TRIAGEM_URGENTE_CONVERSAS=Bruno Figueiredo,DPD
# Radicais, não palavras inteiras: "avari" apanha avaria, avariou, avariada.
TRIAGEM_URGENTE_PALAVRAS=acident,avari,sinistr,reboqu,reboc,guinch,parado na,bateu,despist,seguradora,oficina,multa,apreendid,urgente,urgencia
TRIAGEM_IGNORAR_CONVERSAS=

# Pulsação: avisa se o telemóvel deixar de reencaminhar durante o horário útil.
TRIAGEM_PULSO_HORAS=3
TRIAGEM_PULSO_INICIO=8
TRIAGEM_PULSO_FIM=21
